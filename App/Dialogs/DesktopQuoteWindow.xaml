<Window x:Class="SharkBlocker.Dialogs.DesktopQuoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SharkBlocker.Controls"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" Focusable="False"
        Title="SharkBlocker - Frase do dia"
        Foreground="{StaticResource ColorTextPrimary}" FontFamily="{StaticResource UiFont}" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <!-- Widget da Frase do Dia da Ellen: fica por cima das outras janelas, sem roubar o foco e sem
         aparecer no Alt+Tab. Por padrão no canto inferior esquerdo (acima da barra de tarefas), mas dá
         para ARRASTAR para qualquer canto de qualquer monitor (a posição é lembrada) e COMPACTAR para
         mostrar só o avatar (clique no avatar para expandir; botão direito abre mais opções).
         A margem de 14 é a folga da sombra (ver CardMargin em DesktopQuoteWindow.xaml.cs). O "x"
         esconde o widget até o próximo início do app (ou até reativar pelo menu da bandeja). A lua
         liga o Modo Silêncio: some por 1 hora e a Ellen não puxa assunto. -->
    <Grid x:Name="Root" RenderOptions.BitmapScalingMode="HighQuality"
          MouseLeftButtonDown="Root_MouseLeftButtonDown" MouseMove="Root_MouseMove"
          MouseLeftButtonUp="Root_MouseLeftButtonUp" LostMouseCapture="Root_LostMouseCapture"
          MouseRightButtonUp="Root_MouseRightButtonUp">
        <Border x:Name="CardHost" Margin="14" CornerRadius="14" Background="#01000000">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.6" Color="#000000"/>
            </Border.Effect>
            <controls:EllenQuoteCard x:Name="Card" Width="460"/>
        </Border>

        <Button x:Name="HideButton" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0"
                Width="22" Height="22" Cursor="Hand" ToolTip="Esconder (volta pelo menu da bandeja)"
                Click="HideButton_Click" AutomationProperties.Name="Esconder frase">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" CornerRadius="11" Background="{StaticResource ColorSurfaceRaised}"
                            BorderBrush="{StaticResource ColorBorderStrong}" BorderThickness="1">
                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="9"
                                   Foreground="{StaticResource ColorTextSecondary}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource ColorPrimary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <Button x:Name="CompactButton" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,56,0"
                Width="22" Height="22" Cursor="Hand" ToolTip="Compactar: mostrar só o avatar"
                Click="CompactButton_Click" AutomationProperties.Name="Compactar widget">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" CornerRadius="11" Background="{StaticResource ColorSurfaceRaised}"
                            BorderBrush="{StaticResource ColorBorderStrong}" BorderThickness="1">
                        <TextBlock Text="&#xE73F;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                   Foreground="{StaticResource ColorTextSecondary}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource ColorPrimary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <Button x:Name="SilenceButton" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,30,0"
                Width="22" Height="22" Cursor="Hand" ToolTip="Modo Silêncio: esconder a Ellen por 1 hora"
                Click="SilenceButton_Click" AutomationProperties.Name="Modo Silêncio por 1 hora">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" CornerRadius="11" Background="{StaticResource ColorSurfaceRaised}"
                            BorderBrush="{StaticResource ColorBorderStrong}" BorderThickness="1">
                        <TextBlock Text="&#xE708;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                   Foreground="{StaticResource ColorTextSecondary}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource ColorPrimary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</Window>
