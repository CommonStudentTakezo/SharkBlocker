<Window x:Class="SharkBlocker.Dialogs.GauntletWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" SizeToContent="Height" Width="660"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Foreground="{StaticResource ColorTextPrimary}" FontFamily="{StaticResource UiFont}" FontSize="13"
        UseLayoutRounding="True">

    <Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Shell" Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.18"/>
                    <DoubleAnimation Storyboard.TargetName="ShellScale" Storyboard.TargetProperty="ScaleX"
                                     From="0.95" To="1" Duration="0:0:0.22">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="ShellScale" Storyboard.TargetProperty="ScaleY"
                                     From="0.95" To="1" Duration="0:0:0.22">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Border x:Name="Shell" Style="{StaticResource DialogShell}" RenderTransformOrigin="0.5,0.5"
            MouseLeftButtonDown="Chrome_MouseLeftButtonDown">
        <Border.RenderTransform>
            <ScaleTransform x:Name="ShellScale" ScaleX="1" ScaleY="1"/>
        </Border.RenderTransform>
        <StackPanel>
            <Border Style="{StaticResource DialogHeader}">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Assets/shark-glyph.png" Width="26" Height="26" Margin="0,0,12,0"/>
                    <TextBlock x:Name="TitleText" FontFamily="{StaticResource UiFontDisplay}" FontWeight="SemiBold"
                               FontSize="15" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Grid Margin="24,20,24,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border CornerRadius="12" ClipToBounds="True" Margin="0,0,20,0" VerticalAlignment="Top"
                        BorderBrush="{StaticResource ColorBorder}" BorderThickness="1">
                    <Image Source="/Assets/gauntlet-exit.jpg" Stretch="UniformToFill" Height="200"
                           VerticalAlignment="Top"/>
                </Border>
                <StackPanel Grid.Column="1">
                    <Grid Margin="0,0,0,10">
                        <TextBlock x:Name="CounterText" FontWeight="SemiBold" Foreground="{StaticResource ColorAccent}"/>
                        <TextBlock x:Name="PercentText" HorizontalAlignment="Right"
                                   Foreground="{StaticResource ColorTextMuted}"/>
                    </Grid>
                    <ProgressBar x:Name="Progress" Minimum="0" Maximum="100" Value="0"/>

                    <TextBlock x:Name="QuestionText" TextWrapping="Wrap" FontSize="17" FontWeight="SemiBold"
                               FontFamily="{StaticResource UiFontDisplay}"
                               LineHeight="24" Margin="0,22,0,8" MinHeight="48"/>
                    <TextBlock Style="{StaticResource HelpText}"
                               Text="Responda com calma. Qualquer &quot;Não&quot; cancela tudo e nada é desinstalado."/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                        <Button x:Name="YesButton" Content="Sim, continuar" MinWidth="130"
                                Style="{StaticResource SecondaryButton}" Click="Yes_Click"/>
                        <Button x:Name="NoButton" Content="Não, desistir" MinWidth="130" Margin="10,0,0,0"
                                IsDefault="True" IsCancel="True"
                                Style="{StaticResource PrimaryButton}" Click="No_Click"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</Window>
