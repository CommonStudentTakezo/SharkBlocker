{
  "manifest_version": 3,
  "name": "SharkBlocker - Bloqueio por Palavra-chave",
  "version": "1.16",
  "description": "Bloqueia sites e palavras-chave (incluindo conteúdo adulto) e reforça o SafeSearch, conforme o app SharkBlocker.",
  "key": "",
  "permissions": [
    "tabs",
    "webNavigation",
    "scripting",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "http://127.0.0.1:57411/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "deobf.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html",
        "mascot.png",
        "shark.png",
        "blocked-bg.jpg"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}