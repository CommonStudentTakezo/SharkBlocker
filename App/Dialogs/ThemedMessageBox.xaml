<Window x:Class="SharkBlocker.Dialogs.ThemedMessageBoxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" SizeToContent="Height" Width="540"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Foreground="{StaticResource ColorTextPrimary}" FontFamily="{StaticResource UiFont}" FontSize="13"
        UseLayoutRounding="True">

    <!-- Entrada suave: fade + leve zoom -->
    <Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Shell" Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.18"/>
                    <DoubleAnimation Storyboard.TargetName="ShellScale" Storyboard.TargetProperty="ScaleX"
                                     From="0.95" To="1" Duration="0:0:0.22">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="ShellScale" Storyboard.TargetProperty="ScaleY"
                                     From="0.95" To="1" Duration="0:0:0.22">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Border x:Name="Shell" Style="{StaticResource DialogShell}" RenderTransformOrigin="0.5,0.5"
            MouseLeftButtonDown="Chrome_MouseLeftButtonDown">
        <Border.RenderTransform>
            <ScaleTransform x:Name="ShellScale" ScaleX="1" ScaleY="1"/>
        </Border.RenderTransform>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Faixa de topo: mascote + título -->
            <Border Grid.Row="0" Style="{StaticResource DialogHeader}">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Assets/shark-glyph.png" Width="26" Height="26" Margin="0,0,12,0"/>
                    <TextBlock x:Name="CaptionText" FontFamily="{StaticResource UiFontDisplay}" FontWeight="SemiBold"
                               FontSize="15" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1" MaxHeight="380" VerticalScrollBarVisibility="Auto">
                <Grid Margin="24,22,24,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="IconBadge" Width="38" Height="38" CornerRadius="19"
                            VerticalAlignment="Top" Margin="0,0,16,0">
                        <TextBlock x:Name="IconText" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontWeight="Bold" FontSize="18"/>
                    </Border>
                    <TextBlock x:Name="MessageText" Grid.Column="1" TextWrapping="Wrap" FontSize="13.5" LineHeight="21"
                               Foreground="{StaticResource ColorTextSecondary}"/>
                </Grid>
            </ScrollViewer>

            <StackPanel x:Name="ButtonsPanel" Grid.Row="2" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="24,14,24,22"/>
        </Grid>
    </Border>
</Window>
