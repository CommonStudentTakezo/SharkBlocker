<Window x:Class="SharkBlocker.Dialogs.JournalEntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" SizeToContent="Height" Width="620"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Foreground="{StaticResource ColorTextPrimary}" FontFamily="{StaticResource UiFont}" FontSize="13"
        UseLayoutRounding="True">

    <Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Shell" Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.18"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Border x:Name="Shell" Style="{StaticResource DialogShell}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource DialogHeader}" MouseLeftButtonDown="Chrome_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Assets/shark-glyph.png" Width="26" Height="26" Margin="0,0,12,0"/>
                    <TextBlock x:Name="TitleText" Text="Diário" FontFamily="{StaticResource UiFontDisplay}"
                               FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1" MaxHeight="560" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,18,24,6">

                    <TextBlock Text="O que aconteceu?" Style="{StaticResource Overline}" Margin="0,0,0,8"/>
                    <WrapPanel>
                        <Button x:Name="ModeRelapseButton" Content="Foi uma recaída" Click="ModeRelapseButton_Click"/>
                        <Button x:Name="ModeNoteButton" Content="Só quero anotar a vontade" Click="ModeNoteButton_Click"/>
                    </WrapPanel>
                    <TextBlock x:Name="EffectText" Style="{StaticResource HelpText}" Margin="0,0,0,14" TextWrapping="Wrap"/>

                    <TextBlock Text="O que eu estava sentindo (gatilho)" Style="{StaticResource Overline}" Margin="0,0,0,8"/>
                    <WrapPanel x:Name="TriggerPanel" Margin="0,0,0,6"/>

                    <TextBlock Text="Intensidade da vontade (1 = fraca, 5 = muito forte)" Style="{StaticResource Overline}" Margin="0,8,0,8"/>
                    <WrapPanel x:Name="IntensityPanel" Margin="0,0,0,6"/>

                    <TextBlock Text="O que eu estava fazendo" Style="{StaticResource Overline}" Margin="0,8,0,6"/>
                    <TextBox x:Name="ActivityBox" AcceptsReturn="True" TextWrapping="Wrap" Height="64"
                             VerticalScrollBarVisibility="Auto"/>

                    <TextBlock Text="O que teria ajudado (plano para a próxima vez)" Style="{StaticResource Overline}" Margin="0,14,0,6"/>
                    <TextBox x:Name="HelpBox" AcceptsReturn="True" TextWrapping="Wrap" Height="64"
                             VerticalScrollBarVisibility="Auto"/>

                    <TextBlock Style="{StaticResource HelpText}" Margin="0,12,0,0" TextWrapping="Wrap"
                               Text="O texto fica só neste PC (nada é enviado, nem vai para o log ou para o diagnóstico). Tudo é opcional."/>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,14,24,22">
                <Button x:Name="CancelButton" Content="Cancelar" MinWidth="110" IsCancel="True"
                        Style="{StaticResource SecondaryButton}" Click="CancelButton_Click"/>
                <Button x:Name="SaveButton" Content="Salvar" MinWidth="130" Margin="10,0,0,0"
                        Style="{StaticResource PrimaryButton}" Click="SaveButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
