<Application x:Class="SharkBlocker.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:SharkBlocker.Services">
    <Application.Resources>
        <ResourceDictionary>

            <!-- ============================================================
                 TEMA "ELLEN JOE" v2: dark mode sóbrio e limpo.
                 Base: grafite quase neutro (com um toque de violeta) para dar foco e seriedade.
                 Destaque: carmesim da Ellen, usado com economia (ação principal, aba ativa,
                 foco do teclado). Rosa só em detalhes; azul-gelo só para informação.
                 Os NOMES das chaves originais foram mantidos (ColorDanger, ColorSurface...),
                 então qualquer FindResource("...") do código continua funcionando.
                 ============================================================ -->
            <SolidColorBrush x:Key="ColorBackground" Color="#0E0D13"/>
            <SolidColorBrush x:Key="ColorSurface" Color="#17151E"/>
            <SolidColorBrush x:Key="ColorSurfaceAlt" Color="#1F1C28"/>
            <SolidColorBrush x:Key="ColorSurfaceRaised" Color="#27232F"/>
            <!-- Igual ao ColorSurface, mas ~90% opaco: deixa a arte de fundo aparecer só um pouco -->
            <SolidColorBrush x:Key="ColorCard" Color="#E617151E"/>
            <SolidColorBrush x:Key="ColorBorder" Color="#2E2A3A"/>
            <SolidColorBrush x:Key="ColorBorderStrong" Color="#443E54"/>
            <SolidColorBrush x:Key="ColorTextPrimary" Color="#F3F1F6"/>
            <SolidColorBrush x:Key="ColorTextSecondary" Color="#C9C4D3"/>
            <SolidColorBrush x:Key="ColorTextMuted" Color="#9A94A8"/>

            <SolidColorBrush x:Key="ColorPrimary" Color="#E0264D"/>
            <SolidColorBrush x:Key="ColorPrimaryDark" Color="#B31B3D"/>
            <SolidColorBrush x:Key="ColorAccent" Color="#FF6B8E"/>
            <SolidColorBrush x:Key="ColorIce" Color="#9EDBF0"/>
            <SolidColorBrush x:Key="ColorDanger" Color="#E5384F"/>
            <SolidColorBrush x:Key="ColorDangerDark" Color="#8F1D2E"/>
            <SolidColorBrush x:Key="ColorSuccess" Color="#3DDC97"/>
            <SolidColorBrush x:Key="ColorWarning" Color="#F5B83D"/>

            <!-- Fontes: Segoe UI Variable (Windows 11) com queda para Segoe UI (Windows 10) -->
            <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
            <FontFamily x:Key="UiFontDisplay">Segoe UI Variable Display, Segoe UI</FontFamily>
            <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

            <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1B1822" Offset="0"/>
                <GradientStop Color="#221421" Offset="0.75"/>
                <GradientStop Color="#33121F" Offset="1"/>
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#EE2D58" Offset="0"/>
                <GradientStop Color="#C91E47" Offset="1"/>
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="AccentBorderGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#E0264D" Offset="0"/>
                <GradientStop Color="#FF6B8E" Offset="0.55"/>
                <GradientStop Color="#5A3A55" Offset="1"/>
            </LinearGradientBrush>

            <!-- OBS: de propósito NÃO existe um estilo implícito para TextBlock. Ele vazaria para
                 dentro dos templates (botões, abas) e anularia as cores de cada controle. A cor
                 padrão do texto vem do Foreground de cada janela (herança). -->

            <!-- = Tipografia = -->
            <Style x:Key="TitleLarge" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource UiFontDisplay}"/>
                <Setter Property="FontSize" Value="22"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{StaticResource ColorTextPrimary}"/>
            </Style>

            <Style x:Key="SectionHeader" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource UiFontDisplay}"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource ColorTextPrimary}"/>
                <Setter Property="Margin" Value="0,0,0,4"/>
            </Style>

            <!-- Rótulo pequeno em maiúsculas (escreva o texto já em maiúsculas) -->
            <Style x:Key="Overline" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10.5"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{StaticResource ColorAccent}"/>
                <Setter Property="Opacity" Value="0.95"/>
            </Style>

            <Style x:Key="HelpText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="LineHeight" Value="18"/>
                <Setter Property="Foreground" Value="{StaticResource ColorTextMuted}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="0,2,0,0"/>
            </Style>

            <!-- = Cartões = -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource ColorCard}"/>
                <Setter Property="BorderBrush" Value="{StaticResource ColorBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="Padding" Value="18"/>
                <Setter Property="Margin" Value="0,0,0,14"/>
            </Style>

            <!-- = Campos de texto = -->
            <Style TargetType="TextBox">
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="{StaticResource ColorTextPrimary}"/>
                <Setter Property="Background" Value="{StaticResource ColorBackground}"/>
                <Setter Property="BorderBrush" Value="{StaticResource ColorBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CaretBrush" Value="{StaticResource ColorAccent}"/>
                <Setter Property="SelectionBrush" Value="{StaticResource ColorPrimary}"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Grid>
                                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                    <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                                  Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                                </Border>
                                <!-- anel de foco: aparece suavemente -->
                                <Border x:Name="FocusRing" CornerRadius="8" BorderThickness="1.5" Opacity="0"
                                        BorderBrush="{StaticResource ColorAccent}" IsHitTestVisible="False"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ColorBorderStrong}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity"
                                                                 To="0.9" Duration="0:0:0.15"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity"
                                                                 To="0" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="PasswordBox">
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="{StaticResource ColorTextPrimary}"/>
                <Setter Property="Background" Value="{StaticResource ColorBackground}"/>
                <Setter Property="BorderBrush" Value="{StaticResource ColorBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CaretBrush" Value="{StaticResource ColorAccent}"/>
                <Setter Property="SelectionBrush" Value="{StaticResource ColorPrimary}"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="PasswordBox">
                            <Grid>
                                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                    <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False"/>
                                </Border>
                                <Border x:Name="FocusRing" CornerRadius="8" BorderThickness="1.5" Opacity="0"
                                        BorderBrush="{StaticResource ColorAccent}" IsHitTestVisible="False"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ColorBorderStrong}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity"
                                                                 To="0.9" Duration="0:0:0.15"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity"
                                                                 To="0" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- = Botões =
                 Um único template com 3 camadas: fundo, "véu" claro que aparece no mouse-over e
                 anel rosa para hover/foco do teclado. Ao clicar o botão encolhe um pouquinho. -->
            <Style x:Key="BaseButton" TargetType="Button">
                <Setter Property="Padding" Value="16,9"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="ui:ButtonChrome.CornerRadius" Value="9"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                </Grid.RenderTransform>
                                <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="{Binding Path=(ui:ButtonChrome.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      TextElement.Foreground="{TemplateBinding Foreground}"/>
                                </Border>
                                <Border x:Name="Veil" Background="White" Opacity="0" IsHitTestVisible="False"
                                        CornerRadius="{Binding Path=(ui:ButtonChrome.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}"/>
                                <Border x:Name="Ring" BorderBrush="{StaticResource ColorAccent}" BorderThickness="1.5" Opacity="0"
                                        IsHitTestVisible="False"
                                        CornerRadius="{Binding Path=(ui:ButtonChrome.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}"/>
                                <!-- anel do foco por teclado: separado do anel do mouse, para a animação de hover não apagá-lo -->
                                <Border x:Name="FocusRing" BorderBrush="{StaticResource ColorAccent}" BorderThickness="2" Opacity="0"
                                        IsHitTestVisible="False"
                                        CornerRadius="{Binding Path=(ui:ButtonChrome.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Veil" Storyboard.TargetProperty="Opacity"
                                                                 To="0.08" Duration="0:0:0.15"/>
                                                <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity"
                                                                 To="0.45" Duration="0:0:0.15"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Veil" Storyboard.TargetProperty="Opacity"
                                                                 To="0" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity"
                                                                 To="0" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="FocusRing" Property="Opacity" Value="1"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Root"
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                 To="0.97" Duration="0:0:0.07"/>
                                                <DoubleAnimation Storyboard.TargetName="Root"
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                 To="0.97" Duration="0:0:0.07"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Root"
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                 To="1" Duration="0:0:0.12"/>
                                                <DoubleAnimation Storyboard.TargetName="Root"
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                 To="1" Duration="0:0:0.12"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Root" Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
                <Setter Property="Background" Value="{StaticResource PrimaryGradient}"/>
                <Setter Property="BorderBrush" Value="{StaticResource ColorPrimary}"/>
                <Setter Property="Foreground" Value="White"/>
            </Style>

            <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
                <Setter Property="Background" Value="{StaticResource ColorDangerDark}"/>
                <Setter Property="BorderBrush" Value="{StaticResource ColorDanger}"/>
                <Setter Property="Foreground" Value="White"/>
            </Style>

            <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
                <Setter Property="Background" Value="{StaticResource ColorSurfaceAlt}"/>
                <Setter Property="BorderBrush" Value="{StaticResource ColorBorder}"/>
                <Setter Property="Foreground" Value="{StaticResource ColorTextPrimary}"/>
            </Style>

            <!-- Pílula pequena, usada nos atalhos de minutos -->
            <Style x:Key="ChipButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                <Setter Property="Padding" Value="14,6"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Margin" Value="0,0,8,8"/>
                <Setter Property="ui:ButtonChrome.CornerRadius" Value="16"/>
            </Style>

            <!-- Botão discreto, sem moldura (ex.: "outra frase") -->
            <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource ColorTextMuted}"/>
                <Setter Property="Padding" Value="8,5"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="Normal"/>
                <Setter Property="ui:ButtonChrome.CornerRadius" Value="8"/>
            </Style>

            <!-- Botão padrão do app inteiro (qualquer <Button> sem Style explícito) -->
            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}"/>

            <!-- = Barra de rolagem fina (só vertical é usada neste app) = -->
            <Style TargetType="ScrollBar">
                <Setter Property="Width" Value="10"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border x:Name="Bar" Background="{StaticResource ColorBorder}" CornerRadius="4" Margin="3,0,3,0"/>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bar" Property="Background" Value="{StaticResource ColorBorderStrong}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsDragging" Value="True">
                                                            <Setter TargetName="Bar" Property="Background" Value="{StaticResource ColorAccent}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- = Abas: sublinhado carmesim que "cresce" a partir do centro = -->
            <Style TargetType="TabControl">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabControl">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" BorderBrush="{StaticResource ColorBorder}" BorderThickness="0,0,0,1"
                                        Margin="24,0,24,0">
                                    <StackPanel IsItemsHost="True" Orientation="Horizontal"/>
                                </Border>
                                <ContentPresenter Grid.Row="1" ContentSource="SelectedContent"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="TabItem">
                <Setter Property="Foreground" Value="{StaticResource ColorTextMuted}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="4,11"/>
                <Setter Property="Margin" Value="0,0,22,0"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Grid Background="Transparent" Cursor="Hand">
                                <ContentPresenter ContentSource="Header" Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                                <Border x:Name="Indicator" Height="3" VerticalAlignment="Bottom" CornerRadius="2,2,0,0"
                                        Background="{StaticResource ColorPrimary}" RenderTransformOrigin="0.5,1">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="0" ScaleY="1"/>
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource ColorTextSecondary}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource ColorTextPrimary}"/>
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Indicator"
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                 To="1" Duration="0:0:0.22">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Indicator"
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                 To="0" Duration="0:0:0.15"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- = Seção recolhível: seta gira e o conteúdo surge com fade = -->
            <Style TargetType="Expander">
                <Setter Property="Foreground" Value="{StaticResource ColorTextPrimary}"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Expander">
                            <StackPanel>
                                <ToggleButton x:Name="Head" Content="{TemplateBinding Header}"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              Cursor="Hand" Focusable="True" FocusVisualStyle="{x:Null}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="HeadBd" Background="{StaticResource ColorSurfaceAlt}"
                                                    BorderBrush="{StaticResource ColorBorder}" BorderThickness="1"
                                                    CornerRadius="10" Padding="14,11">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ContentPresenter VerticalAlignment="Center"
                                                                      TextElement.Foreground="{StaticResource ColorTextPrimary}"
                                                                      TextElement.FontWeight="SemiBold"/>
                                                    <Path x:Name="Chevron" Grid.Column="1" Data="M 0,0 L 5,5 L 10,0"
                                                          Stroke="{StaticResource ColorAccent}" StrokeThickness="1.8"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                          VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                                        <Path.RenderTransform>
                                                            <RotateTransform Angle="0"/>
                                                        </Path.RenderTransform>
                                                    </Path>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="HeadBd" Property="BorderBrush" Value="{StaticResource ColorBorderStrong}"/>
                                                    <Setter TargetName="HeadBd" Property="Background" Value="{StaticResource ColorSurfaceRaised}"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="Chevron"
                                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                                 To="180" Duration="0:0:0.2"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                    <Trigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="Chevron"
                                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                                 To="0" Duration="0:0:0.2"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.ExitActions>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter x:Name="Body" Visibility="Collapsed" Margin="0,8,0,0"/>
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsExpanded" Value="True">
                                    <Setter TargetName="Body" Property="Visibility" Value="Visible"/>
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Body" Storyboard.TargetProperty="Opacity"
                                                                 From="0" To="1" Duration="0:0:0.22"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- = Barra de progresso (confirmações): cantos arredondados = -->
            <Style TargetType="ProgressBar">
                <Setter Property="Height" Value="8"/>
                <Setter Property="Foreground" Value="{StaticResource ColorPrimary}"/>
                <Setter Property="Background" Value="{StaticResource ColorSurfaceRaised}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid>
                                <Border x:Name="PART_Track" CornerRadius="4" Background="{TemplateBinding Background}"/>
                                <Border x:Name="PART_Indicator" CornerRadius="4" HorizontalAlignment="Left"
                                        Background="{StaticResource PrimaryGradient}"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- = Janelas de diálogo (sem moldura): entrada suave = -->
            <Style x:Key="DialogShell" TargetType="Border">
                <Setter Property="Margin" Value="16"/>
                <Setter Property="Background" Value="{StaticResource ColorSurface}"/>
                <Setter Property="BorderBrush" Value="{StaticResource ColorBorderStrong}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="16"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="28" ShadowDepth="4" Direction="270" Opacity="0.6" Color="#000000"/>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="DialogHeader" TargetType="Border">
                <Setter Property="CornerRadius" Value="15,15,0,0"/>
                <Setter Property="Background" Value="{StaticResource HeaderGradient}"/>
                <Setter Property="BorderBrush" Value="{StaticResource ColorBorder}"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="Padding" Value="20,14"/>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
