<Window x:Class="SharkBlocker.ScheduleEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" SizeToContent="Height" Width="580"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Foreground="{StaticResource ColorTextPrimary}" FontFamily="{StaticResource UiFont}" FontSize="13"
        UseLayoutRounding="True">

    <Border x:Name="Shell" Style="{StaticResource DialogShell}" MouseLeftButtonDown="Chrome_MouseLeftButtonDown">
        <StackPanel>
            <Border Style="{StaticResource DialogHeader}">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Assets/shark-glyph.png" Width="26" Height="26" Margin="0,0,12,0"/>
                    <TextBlock Text="Bloqueios agendados" FontFamily="{StaticResource UiFontDisplay}" FontWeight="SemiBold"
                               FontSize="15" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <StackPanel Margin="24,18,24,22">
                <TextBlock x:Name="IntroText" TextWrapping="Wrap" Margin="0,0,0,12" LineHeight="20"
                           Foreground="{StaticResource ColorTextSecondary}"/>

                <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="RowsHost"/>
                </ScrollViewer>

                <Button x:Name="AddButton" Content="Adicionar horário" HorizontalAlignment="Left" Margin="0,6,0,0"
                        Click="AddButton_Click"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button Content="Cancelar" MinWidth="100" IsCancel="True" Click="Cancel_Click"/>
                    <Button Content="Salvar" MinWidth="100" Margin="10,0,0,0" IsDefault="True"
                            Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
