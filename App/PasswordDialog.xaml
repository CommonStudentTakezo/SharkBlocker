<Window x:Class="SharkBlocker.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" SizeToContent="Height" Width="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Foreground="{StaticResource ColorTextPrimary}" FontFamily="{StaticResource UiFont}" FontSize="13"
        UseLayoutRounding="True">

    <Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Shell" Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.18"/>
                    <DoubleAnimation Storyboard.TargetName="ShellScale" Storyboard.TargetProperty="ScaleX"
                                     From="0.95" To="1" Duration="0:0:0.22">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="ShellScale" Storyboard.TargetProperty="ScaleY"
                                     From="0.95" To="1" Duration="0:0:0.22">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Border x:Name="Shell" Style="{StaticResource DialogShell}" RenderTransformOrigin="0.5,0.5"
            MouseLeftButtonDown="Chrome_MouseLeftButtonDown">
        <Border.RenderTransform>
            <ScaleTransform x:Name="ShellScale" ScaleX="1" ScaleY="1"/>
        </Border.RenderTransform>
        <StackPanel>
            <Border Style="{StaticResource DialogHeader}">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Assets/shark-glyph.png" Width="26" Height="26" Margin="0,0,12,0"/>
                    <TextBlock Text="Senha" FontFamily="{StaticResource UiFontDisplay}" FontWeight="SemiBold"
                               FontSize="15" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <StackPanel Margin="24,20,24,22">
                <TextBlock x:Name="PromptText" Text="Digite a senha:" TextWrapping="Wrap" Margin="0,0,0,12"
                           Foreground="{StaticResource ColorTextSecondary}" LineHeight="20"/>
                <PasswordBox x:Name="PasswordInput" FontSize="14"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                    <Button Content="Cancelar" MinWidth="100" IsCancel="True" Click="Cancel_Click"/>
                    <Button Content="OK" MinWidth="100" Margin="10,0,0,0" IsDefault="True"
                            Style="{StaticResource PrimaryButton}" Click="Ok_Click"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
