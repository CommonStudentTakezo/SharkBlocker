<UserControl x:Class="SharkBlocker.Controls.EllenQuoteCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{StaticResource ColorTextPrimary}">
    <!-- Card "Frase do Dia": a Ellen (chibi) à esquerda e um balão de fala à direita.
         O balão tem uma "ponta" apontando para ela. O texto é digitado aos poucos (typewriter) e
         um segundo TextBlock invisível reserva a altura final, para o card não ficar pulando. -->
    <Border x:Name="CardRoot" Style="{StaticResource Card}" Padding="12,10" CornerRadius="14" Margin="0"
            BorderBrush="{StaticResource ColorBorder}">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F0211A28" Offset="0"/>
                <GradientStop Color="#F02A1624" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Avatar da Ellen -->
            <Grid Width="72" Height="72" VerticalAlignment="Top" Margin="0,2,0,0">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="AvatarBob" Y="0"/>
                </Grid.RenderTransform>
                <Border CornerRadius="20" BorderThickness="2" BorderBrush="{StaticResource AccentBorderGradient}">
                    <Border.Background>
                        <RadialGradientBrush Center="0.5,0.4" RadiusX="0.8" RadiusY="0.8">
                            <GradientStop Color="#3A1A2C" Offset="0"/>
                            <GradientStop Color="#15121B" Offset="1"/>
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>
                <Border x:Name="AvatarFace" CornerRadius="18" Margin="5">
                    <Border.Background>
                        <ImageBrush x:Name="AvatarBrush" Stretch="Uniform"/>
                    </Border.Background>
                </Border>
            </Grid>

            <!-- Balão de fala -->
            <Grid x:Name="BubbleHost" Grid.Column="1" Margin="14,0,0,0">
                <Border x:Name="Bubble" Background="{StaticResource ColorSurfaceAlt}"
                        BorderBrush="{StaticResource ColorBorderStrong}" BorderThickness="1"
                        CornerRadius="14" Padding="14,10,10,10">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Fill="{StaticResource ColorPrimary}" Margin="0,0,8,0"
                                         VerticalAlignment="Center"/>
                                <TextBlock x:Name="OverlineText" Text="FRASE DO DIA" Style="{StaticResource Overline}"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="DateText" Foreground="{StaticResource ColorTextMuted}" FontSize="11"
                                           Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button x:Name="AnotherButton" Grid.Column="1" Style="{StaticResource GhostButton}"
                                    ToolTip="Ver outra frase da Ellen" Click="AnotherButton_Click"
                                    AutomationProperties.Name="Outra frase">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Grid Margin="0,6,0,0">
                            <!-- reserva a altura final do texto -->
                            <TextBlock x:Name="QuoteSizer" Opacity="0" FontSize="14" LineHeight="21"
                                       FontFamily="{StaticResource UiFontDisplay}" TextWrapping="Wrap"/>
                            <TextBlock x:Name="QuoteText" FontSize="14" LineHeight="21" FontWeight="Medium"
                                       FontFamily="{StaticResource UiFontDisplay}" TextWrapping="Wrap"
                                       Foreground="{StaticResource ColorTextPrimary}"/>
                        </Grid>

                        <TextBlock Text="Ellen Joe" Foreground="{StaticResource ColorAccent}" FontSize="12"
                                   FontWeight="SemiBold" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ponta do balão (preenchimento cobre a borda do balão; a linha desenha o contorno) -->
                <Polygon Points="11,0 1,10 11,20" Fill="{StaticResource ColorSurfaceAlt}"
                         HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-10,20,0,0"
                         Width="11" Height="20" IsHitTestVisible="False"/>
                <Polyline Points="11,0 1,10 11,20" Stroke="{StaticResource ColorBorderStrong}" StrokeThickness="1"
                          HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-10,20,0,0"
                          Width="11" Height="20" IsHitTestVisible="False"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
